        </div>
    </div>

    <script>
        // Configuration
        const CONFIG = {
            orgId: '545a3bce-97c5-4732-af38-1ac459087b0a'
        };

        // Fetch vulnerabilities for training stats
        async function fetchVulnerabilities() {
            try {
                const response = await fetch(`/api/contrast/api/ng/${CONFIG.orgId}/orgtraces/filter?expand=skip_links&limit=100`, {
                    headers: { 'Accept': 'application/json' }
                });

                if (!response.ok) {
                    console.error('Failed to fetch vulnerabilities');
                    return [];
                }

                const result = await response.json();
                return result.traces || [];
            } catch (error) {
                console.error('Error fetching vulnerabilities:', error);
                return [];
            }
        }

        // Update security posture stats with real data
        async function updateSecurityStats() {
            const vulns = await fetchVulnerabilities();

            if (vulns.length > 0) {
                const critical = vulns.filter(v => v.severity === 'Critical').length;
                const high = vulns.filter(v => v.severity === 'High').length;
                const medium = vulns.filter(v => v.severity === 'Medium').length;

                // Update security posture card
                const statValues = document.querySelectorAll('.card')[1].querySelectorAll('.stat-value');
                if (statValues[0]) statValues[0].textContent = critical;
                if (statValues[1]) statValues[1].textContent = high;
                if (statValues[2]) statValues[2].textContent = medium;

                // Update top vulnerabilities if available
                const topVulns = vulns.slice(0, 3);
                const topVulnsList = document.querySelector('.card:nth-child(3) ol');
                if (topVulnsList && topVulns.length > 0) {
                    topVulnsList.innerHTML = topVulns.map(v => {
                        const severityClass = v.severity.toLowerCase();
                        const vulnType = v.rule_name || v.type || 'Unknown';
                        const appName = (v.application?.name || 'Unknown').replace('cargo-cats-contrast-', '').replace('cargo-cats-', '');
                        return `<li><span class="${severityClass}">${vulnType}</span> - ${appName}</li>`;
                    }).join('');
                }
            }
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', updateSecurityStats);

        // State management
        let lessonsCompleted = 0;
        let questionsCorrect = 0;
        let startTime = Date.now();

        // Update training time
        setInterval(() => {
            const minutes = Math.floor((Date.now() - startTime) / 60000);
            document.getElementById('trainingTime').textContent = minutes + ' min';
        }, 60000);

        // Toggle lesson content
        function toggleLesson(lessonId) {
            const content = document.getElementById(lessonId);
            content.classList.toggle('active');
        }

        // Check quiz answer
        function checkAnswer(questionId, optionId, correctOption) {
            const options = document.querySelectorAll(`#feedback-${questionId}-${optionId}`).parentElement.querySelectorAll('.quiz-option');
            const selectedOption = options[optionId - 1];
            const correctFeedback = document.getElementById(`feedback-${questionId}-1`);
            const incorrectFeedback = document.getElementById(`feedback-${questionId}-2`);

            // Remove previous selections
            options.forEach(opt => {
                opt.classList.remove('selected', 'correct', 'incorrect');
            });

            // Mark selected
            selectedOption.classList.add('selected');

            // Hide all feedback
            correctFeedback.classList.remove('show', 'correct', 'incorrect');
            incorrectFeedback.classList.remove('show', 'correct', 'incorrect');

            // Show appropriate feedback
            if (optionId === correctOption) {
                selectedOption.classList.add('correct');
                correctFeedback.classList.add('show', 'correct');
                questionsCorrect++;
                updateQuizScore();
            } else {
                selectedOption.classList.add('incorrect');
                incorrectFeedback.classList.add('show', 'incorrect');
            }
        }

        // Update quiz score
        function updateQuizScore() {
            document.getElementById('quizScore').textContent = questionsCorrect + ' / 7';
        }

        // Complete lesson
        function completeLesson(lessonNumber) {
            const badge = document.getElementById(`badge${lessonNumber}`);
            if (badge.style.opacity === '0.3') {
                badge.style.opacity = '1';
                lessonsCompleted++;
                updateProgress();

                // Show celebration
                alert(`🎉 Congratulations! You've completed Lesson ${lessonNumber}!\n\nYou earned the "${badge.textContent.trim()}" badge!`);
            }
        }

        // Update overall progress
        function updateProgress() {
            const percentage = (lessonsCompleted / 3) * 100;
            document.getElementById('overallProgress').style.width = percentage + '%';
            document.getElementById('overallProgress').textContent = Math.round(percentage) + '%';
            document.getElementById('completedLessons').textContent = lessonsCompleted + ' / 3';
        }

        // Auto-open first lesson on load
        window.addEventListener('load', () => {
            document.getElementById('lesson1').classList.add('active');
        });
    </script>
</body>
</html>