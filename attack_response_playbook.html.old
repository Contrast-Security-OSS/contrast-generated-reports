    <script>
        // Configuration
        const CONFIG = {
            orgId: '545a3bce-97c5-4732-af38-1ac459087b0a'
        };

        // Fetch attack incidents from Contrast API
        async function fetchAttackIncidents() {
            try {
                const response = await fetch(`/api/contrast/api/ng/${CONFIG.orgId}/attacks?limit=20`, {
                    headers: { 'Accept': 'application/json' }
                });

                if (!response.ok) {
                    console.error('Failed to fetch attack incidents');
                    return [];
                }

                const result = await response.json();
                return result.attacks || [];
            } catch (error) {
                console.error('Error fetching attack incidents:', error);
                return [];
            }
        }

        // Update page with real attack data
        async function updateAttackData() {
            const attacks = await fetchAttackIncidents();

            if (attacks.length > 0) {
                // Use the first EXPLOITED attack, or first attack if none exploited
                const exploitedAttack = attacks.find(a => a.status === 'EXPLOITED') || attacks[0];

                // Update header
                if (exploitedAttack.attackId) {
                    document.querySelector('.incident-id').textContent = `Incident ID: ${exploitedAttack.attackId}`;
                }

                // Update critical banner if status is EXPLOITED
                if (exploitedAttack.status === 'EXPLOITED') {
                    const banner = document.querySelector('.critical-banner');
                    if (banner) {
                        banner.querySelector('h2').innerHTML = `<span class="icon">🚨</span> ${exploitedAttack.status} - Real Attack Detected`;
                        const details = banner.querySelectorAll('.alert-detail-value');
                        if (details[0]) details[0].textContent = exploitedAttack.source || 'Unknown';
                        if (details[1] && exploitedAttack.rules) details[1].textContent = exploitedAttack.rules.map(r => r.name || r).join(', ');
                        if (details[2] && exploitedAttack.applications) details[2].textContent = exploitedAttack.applications.map(a => a.name || a).join(', ');
                    }
                }

                // Update related attacks table
                const relatedTable = document.querySelector('.card:last-child table');
                if (relatedTable && attacks.length > 1) {
                    const tbody = relatedTable.querySelector('tbody') || relatedTable;
                    const rows = attacks.slice(0, 5).map(attack => `
                        <tr>
                            <td><span class="ip-address">${attack.source || 'Unknown'}</span></td>
                            <td><span class="badge badge-${attack.status === 'EXPLOITED' ? 'critical' : 'warning'}">${attack.status || 'PROBED'}</span></td>
                            <td>${attack.probes || 0}</td>
                        </tr>
                    `).join('');

                    const headerRow = tbody.querySelector('tr:first-child');
                    if (headerRow && headerRow.querySelector('th')) {
                        tbody.innerHTML = headerRow.outerHTML + rows;
                    }
                }
            }
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', updateAttackData);

        function toggleChecked(checkbox) {
            const item = checkbox.parentElement;
            if (checkbox.checked) {
                item.classList.add('checked');
            } else {
                item.classList.remove('checked');
            }
            updateProgress();
        }

        function updateProgress() {
            const checkboxes = document.querySelectorAll('.checklist-item input[type="checkbox"]');
            const checked = document.querySelectorAll('.checklist-item input[type="checkbox"]:checked').length;
            const total = checkboxes.length;
            const percentage = Math.round((checked / total) * 100);

            // Update progress bar if you want to track all actions
            // For now, we're showing workflow progress separately
        }

        // Add click handlers to checklist items
        document.querySelectorAll('.checklist-item').forEach(item => {
            item.addEventListener('click', (e) => {
                if (e.target.tagName !== 'INPUT') {
                    const checkbox = item.querySelector('input[type="checkbox"]');
                    checkbox.checked = !checkbox.checked;
                    toggleChecked(checkbox);
                }
            });
        });

        // Auto-save checklist state to localStorage
        document.querySelectorAll('.checklist-item input[type="checkbox"]').forEach(checkbox => {
            const savedState = localStorage.getItem(checkbox.id);
            if (savedState === 'true') {
                checkbox.checked = true;
                toggleChecked(checkbox);
            }

            checkbox.addEventListener('change', () => {
                localStorage.setItem(checkbox.id, checkbox.checked);
            });
        });
    </script>
</body>
</html>