        <!-- Footer -->
        <div style="margin-top: 40px; padding: 20px; text-align: center; color: #94a3b8; border-top: 2px solid rgba(102, 126, 234, 0.3);">
            <p><strong>Incident Response Playbook</strong> | Generated: 2026-01-15 21:32:00 UTC</p>
            <p>Incident ID: c7049a6c-8ae4-4f11-bdf8-c58a154c3bba</p>
            <p style="margin-top: 10px; font-size: 0.9em;">
                This is a confidential security document. Distribution limited to incident response team and authorized personnel only.
